@{
    ViewData["Title"] = "Set Global Hourly Rate";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="card-title mb-0">Set Global Hourly Rate</h4>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="alert alert-info">
                        <h5>Current Action:</h5>
                        <p class="mb-0">This will set <strong>R40.00 per hour</strong> for <strong>ALL lecturers</strong> in the system.</p>
                    </div>

                    <form method="post" asp-action="SetRate">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Hourly Rate</label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input type="text" class="form-control form-control-lg" value="40.00" readonly style="font-weight: bold; font-size: 1.2rem;" />
                            </div>
                            <div class="form-text">This rate will apply to all lecturers automatically</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">Set R40 for All Lecturers</button>
                            <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
                        </div>
                    </form>

                    <!-- Quick Stats -->
                    <div class="mt-4 p-3 bg-light rounded">
                        <h6>System Impact:</h6>
                        <ul class="mb-0">
                            <li>All existing lecturers will have their rate updated to R40/hour</li>
                            <li>New claims will automatically use R40/hour</li>
                            <li>Existing pending claims will use the rate at time of submission</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>