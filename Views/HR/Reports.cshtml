@model IEnumerable<CMCSystem.Models.Claim>
@{
    ViewData["Title"] = "Claims Report";
}

<div class="container mt-4">
    <h2>Claims Report</h2>

    <!-- Simple Navigation -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-secondary">Back to HR Dashboard</a>
        <a class="btn btn-outline-primary" asp-action="ExportClaims" asp-route-type="csv">Export CSV</a>
        <a class="btn btn-outline-primary" asp-action="ExportClaims" asp-route-type="pdf">Export PDF</a>
    </div>

    <!-- Simple Summary -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-light">
                <div class="card-body text-center">
                    <h6>Total Claims</h6>
                    <h4>@Model.Count()</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h6>Approved</h6>
                    <h4>@Model.Count(c => c.Status == CMCSystem.Models.ClaimStatus.ApprovedByManager)</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning">
                <div class="card-body text-center">
                    <h6>Pending</h6>
                    <h4>@Model.Count(c => c.Status == CMCSystem.Models.ClaimStatus.Pending)</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body text-center">
                    <h6>Rejected</h6>
                    <h4>@Model.Count(c => c.Status == CMCSystem.Models.ClaimStatus.RejectedByManager || c.Status == CMCSystem.Models.ClaimStatus.RejectedByCoordinator)</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Simple Table -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Lecturer</th>
                            <th>Hours</th>
                            <th>Rate (R)</th>
                            <th>Total (R)</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Document</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model)
                        {
                            <tr>
                                <td><strong>@claim.ClaimId</strong></td>
                                <td>@claim.LecturerName</td>
                                <td>@claim.HoursWorked</td>
                                <td>@claim.HourlyRate.ToString("F2")</td>
                                <td><strong>@claim.TotalAmount.ToString("F2")</strong></td>
                                <td>
                                    @if (claim.Status == CMCSystem.Models.ClaimStatus.ApprovedByManager)
                                    {
                                        <span class="badge bg-success">APPROVED</span>
                                    }
                                    else if (claim.Status == CMCSystem.Models.ClaimStatus.RejectedByManager)
                                    {
                                        <span class="badge bg-danger">REJECTED</span>
                                    }
                                    else if (claim.Status == CMCSystem.Models.ClaimStatus.RejectedByCoordinator)
                                    {
                                        <span class="badge bg-danger">REJECTED</span>
                                    }
                                    else if (claim.Status == CMCSystem.Models.ClaimStatus.ApprovedByCoordinator)
                                    {
                                        <span class="badge bg-primary">COORD APPROVED</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">PENDING</span>
                                    }
                                </td>
                                <td>@claim.DateSubmitted.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(claim.SupportingDocumentPath))
                                    {
                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-controller="Claim"
                                           asp-action="DownloadDocument"
                                           asp-route-id="@claim.ClaimId">
                                            📄
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-4">
                    <p class="text-muted">No claims found in the system.</p>
                </div>
            }
        </div>
    </div>

    <!-- Quick Status Legend -->
    <div class="mt-3">
        <small class="text-muted">
            <strong>Status Legend:</strong>
            <span class="badge bg-success">APPROVED</span> - Final approved claims |
            <span class="badge bg-primary">COORD APPROVED</span> - Coordinator approved |
            <span class="badge bg-warning">PENDING</span> - Waiting for approval |
            <span class="badge bg-danger">REJECTED</span> - Rejected claims
        </small>
    </div>
</div>