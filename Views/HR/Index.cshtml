@model IEnumerable<CMCSystem.Models.Lecturer>
@{
    ViewData["Title"] = "HR Dashboard";
    var stats = ViewBag.DashboardStats as dynamic;
}
<div class="container mt-4">
    <h2>HR Dashboard</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total Lecturers</h5>
                    <h2 class="card-text">@stats.TotalLecturers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Total Claims</h5>
                    <h2 class="card-text">@stats.TotalClaims</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Pending Claims</h5>
                    <h2 class="card-text">@stats.PendingClaims</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Approved Claims</h5>
                    <h2 class="card-text">@stats.ApprovedClaims</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        
                        <div class="col-md-3 mb-2">
                            <a class="btn btn-secondary w-100" asp-action="SetRate">Set Lecturer Rate</a>
                        </div>
                        
                        <div class="col-md-3 mb-2">
                            <a class="btn btn-info w-100" asp-action="Reports">View Reports</a>
                        </div>
                        
                        
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lecturers Table -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Lecturers</h5>
            <span class="badge bg-primary">@Model.Count() Total</span>
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Hourly Rate</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td>@l.LecturerId</td>
                            <td>@l.FullName</td>
                            <td>@l.Email</td>
                            <td>R@(l.HourlyRate.ToString("F2"))</td>
                            <td>
                                <a class="btn btn-sm btn-outline-danger" asp-action="DeleteLecturer" asp-route-id="@l.LecturerId">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="alert alert-info">No lecturers found. <a asp-action="CreateLecturer">Create the first lecturer</a></div>
            }
        </div>
    </div>
</div>