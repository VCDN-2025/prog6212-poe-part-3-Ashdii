@model CMCSystem.Models.Claim
@{
    ViewData["Title"] = "Submit Claim";
}
<div class="container mt-4" style="max-width:800px;">
    <h2>Submit Claim</h2>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label">Lecturer Name</label>
            <input asp-for="LecturerName" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Hours Worked</label>
            <input asp-for="HoursWorked" class="form-control" step="0.01" min="0.01" required />
            <span asp-validation-for="HoursWorked" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Hourly Rate</label>
            <div class="input-group">
                <span class="input-group-text">R</span>
                <input asp-for="HourlyRate" class="form-control" readonly />
            </div>
            <small class="form-text text-muted">
                Your hourly rate is set by HR to <strong>R@(Model.HourlyRate.ToString("F2"))</strong> per hour
            </small>
        </div>

        <!-- Show calculated total -->
        <div class="mb-3 alert alert-info">
            <strong>Estimated Total: R<span id="estimatedTotal">0.00</span></strong><br>
            <small>Calculated as: Hours Worked × Hourly Rate</small>
        </div>

        <div class="mb-3">
            <label class="form-label">Supporting Document (optional)</label>
            <input type="file" name="supportingDocument" accept=".pdf,.doc,.docx,.jpg,.png,.xlsx" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success">Submit Claim</button>
        <a asp-action="MyClaims" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Calculate estimated total when hours change
        document.addEventListener('DOMContentLoaded', function() {
            const hoursInput = document.querySelector('#HoursWorked');
            const hourlyRate = @Model.HourlyRate;
            const totalSpan = document.querySelector('#estimatedTotal');

            function updateTotal() {
                const hours = parseFloat(hoursInput.value) || 0;
                const total = hours * hourlyRate;
                totalSpan.textContent = total.toFixed(2);
            }

            hoursInput.addEventListener('input', updateTotal);
            updateTotal(); // Initial calculation
        });
    </script>
}