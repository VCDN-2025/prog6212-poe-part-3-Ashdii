@model IEnumerable<CMCSystem.Models.Claim>
@{
    ViewData["Title"] = "Pending Claims for Approval";
}

<div class="container mt-4">
    <<h2>Pending Claims for Approval</h2>
    <!-- Change the card header to: -->
    <div class="card-header bg-primary text-white">
        <h5 class="card-title mb-0">Pending Claims - Approve or Reject</h5>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">Claims Awaiting Approval</h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Claim ID</th>
                                <th>Lecturer</th>
                                <th>Hours</th>
                                <th>Rate (R)</th>
                                <th>Total (R)</th>
                                <th>Submitted</th>
                                <th>Document</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in Model)
                            {
                                <tr>
                                    <td>@claim.ClaimId</td>
                                    <td>@claim.LecturerName</td>
                                    <td>@claim.HoursWorked.ToString("F2")</td>
                                    <td>@claim.HourlyRate.ToString("F2")</td>
                                    <td><strong>@claim.TotalAmount.ToString("F2")</strong></td>
                                    <td>@claim.DateSubmitted.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(claim.SupportingDocumentPath))
                                        {
                                            <a class="btn btn-sm btn-outline-info"
                                               asp-controller="Claim"
                                               asp-action="DownloadDocument"
                                               asp-route-id="@claim.ClaimId">
                                                Download
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No document</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <form method="post" asp-action="Approve" class="d-inline">
                                                <input type="hidden" name="id" value="@claim.ClaimId" />
                                                <button type="submit" class="btn btn-sm btn-success"
                                                        onclick="return confirm('Are you sure you want to approve this claim?')">
                                                    Approve
                                                </button>
                                            </form>

                                            <button type="button" class="btn btn-sm btn-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#rejectModal@(claim.ClaimId)">
                                                Reject
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Reject Modal for each claim -->
                                <div class="modal fade" id="rejectModal@(claim.ClaimId)" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title">Reject Claim #@claim.ClaimId</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form method="post" asp-action="Reject">
                                                <div class="modal-body">
                                                    <input type="hidden" name="id" value="@claim.ClaimId" />
                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold">Rejection Reason</label>
                                                        <textarea name="comments" class="form-control" rows="4"
                                                          placeholder="Please provide a reason for rejecting this claim..." required></textarea>
                                                        <div class="form-text">This comment will be visible to the lecturer.</div>
                                                    </div>
                                                    <div class="alert alert-warning">
                                                        <i class="fas fa-exclamation-triangle"></i>
                                                        <strong>Warning:</strong> This action cannot be undone.
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger">Reject Claim</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                    <h4>No Pending Claims</h4>
                    <p class="text-muted">There are no claims waiting for your approval at this time.</p>
                </div>
            }
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card text-white bg-info">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Pending</h5>
                    <h2 class="card-text">@Model.Count()</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-warning">
                <div class="card-body text-center">
                    <h5 class="card-title">Awaiting Action</h5>
                    <h2 class="card-text">@Model.Count()</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success">
                <div class="card-body text-center">
                    <h5 class="card-title">Ready to Review</h5>
                    <h2 class="card-text">@Model.Count()</h2>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            $('.alert').alert('close');
        }, 5000);
    </script>
}